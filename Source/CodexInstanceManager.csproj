<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\mm-agentwork-icon.ico</ApplicationIcon>
    <Product>AIMoreMoreWork</Product>
    <AssemblyTitle>AIMoreMoreWork</AssemblyTitle>
    <AssemblyName>CodexInstanceManager</AssemblyName>
    <RootNamespace>CodexInstanceManager</RootNamespace>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\mm-agentwork-icon.ico" LogicalName="MmAgentWork.Icon" />
    <EmbeddedResource Include="Assets\mm-agentwork-background.png" LogicalName="MmAgentWork.Background" />
    <EmbeddedResource Include="Assets\Avatars\*.png">
      <LogicalName>MmAgentWork.Avatar.%(Filename)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.21" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Tomlyn" Version="0.19.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
</Project>
